static func get_level_count() -> int:
	return LEVELS.size()

static func get_level_data(level_index: int) -> String:
	if level_index < 0 or level_index >= LEVELS.size():
		push_error("Level index out of bounds: %d" % level_index)
		return ""
	return LEVELS[level_index]
