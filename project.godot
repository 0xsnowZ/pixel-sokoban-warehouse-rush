; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pixel Sokoban: Warehouse Rush"
run/main_scene="res://scenes/splash_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0235294, 0.0352941, 0.0666667, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/stretch_mode=4
config/icon="res://icon.png"
boot_splash/minimum_display_time=200
run/max_fps=60

[autoload]

SaveManager="*res://scripts/save_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
LocalizationManager="*res://scripts/localization_manager.gd"
AdManager="*res://scripts/ad_manager.gd"
HapticManager="*res://scripts/haptic_manager.gd"
SafeAreaManager="*res://scripts/safe_area_manager.gd"
AchievementManager="*res://scripts/achievement_manager.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=30
2d/default_gravity=0.0

[gui]

theme/custom="res://assets/theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.0235294, 0.0352941, 0.0666667, 1)

